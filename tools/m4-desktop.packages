# General desktop requirements omitted by the initial J713 image.
# Install alongside Omarchy's omarchy-base.packages, before configuring the image.
sudo
base-devel
autoconf-archive
gst-plugin-pipewire
# autoaudiosink and pulsesink: WebKitGTK and other GStreamer apps are silent without them.
gst-plugins-good
pipewire-alsa
pipewire-jack
pipewire-pulse
zram-generator
# Requested process viewer; Omarchy also retains its stock btop.
htop
