+static int dchid_open_retry(struct dchid_iface *iface)
+{
+	int ret = -ETIMEDOUT;
+	unsigned int attempt;
+
+	/* READY handling must remain independent of this sleeping lock. */
+	mutex_lock(&iface->start_mutex);
+	for (attempt = 0; attempt < J713_START_ATTEMPTS; attempt++) {
+		/* Keep late READY events: the protocol has no attempt identifier. */
+		if (completion_done(&iface->ready)) {
+			ret = 0;
+			break;
+		}
+
+		ret = dchid_start_interface(iface);
+		if (ret < 0)
+			goto done;
+
+		if (wait_for_completion_timeout(&iface->ready,
+						msecs_to_jiffies(START_TIMEOUT_MS))) {
+			ret = 0;
+			break;
+		}
+
+		iface->starting = false;
+		ret = -ETIMEDOUT;
+		dev_warn(iface->dchid->dev, "iface %s READY timed out (attempt %u/%u)\n",
+			 iface->name, attempt + 1, J713_START_ATTEMPTS);
+	}
+
+	/* Also accept READY concurrent with the last wait's timeout. */
+	if (ret == -ETIMEDOUT && completion_done(&iface->ready))
+		ret = 0;
+done:
+	iface->starting = false;
+	if (!ret)
+		iface->open = true;
+	mutex_unlock(&iface->start_mutex);
+	return ret;
+}
