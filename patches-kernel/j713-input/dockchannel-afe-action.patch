+static bool dchid_afe_action_enabled(struct dchid_iface *iface)
+{
+	return m4_afe_action && m4_power_v2 &&
+		of_machine_is_compatible("apple,j713") &&
+		of_machine_is_compatible("apple,t8132") &&
+		!strcmp(iface->name, "multi-touch");
+}
+
+static void dchid_put_afe_smc(void *data)
+{
+	put_device(data);
+}
+
+static int dchid_prepare_afe(struct dchid_iface *iface)
+{
+	struct dockchannel_hid *dchid = iface->dchid;
+	struct apple_smc_key_info info;
+	struct of_phandle_args args;
+	struct platform_device *pdev;
+	struct device_node *smc_node;
+	struct device_link *link;
+	struct apple_smc *smc;
+	struct gpio_desc *gpio;
+	int ret = 0;
+
+	if (!dchid_afe_action_enabled(iface))
+		return 0;
+	if (!IS_REACHABLE(CONFIG_MFD_MACSMC))
+		return -EOPNOTSUPP;
+
+	mutex_lock(&dchid->afe_mutex);
+	if (dchid->afe_ready)
+		goto out;
+	if (!dchid->afe_smc) {
+		ret = of_parse_phandle_with_args(dchid->dev->of_node,
+				"apple,afe-reset-gpios", "#gpio-cells", 0, &args);
+		if (ret)
+			goto out;
+		ret = args.args_count == 2 && args.args[0] == 28 &&
+			args.args[1] == 1 &&
+			of_device_is_compatible(args.np, "apple,smc-gpio") ? 0 : -EINVAL;
+		smc_node = ret ? NULL : of_get_parent(args.np);
+		of_node_put(args.np);
+		if (ret)
+			goto out;
+		if (!smc_node || !of_device_is_compatible(smc_node, "apple,t8132-smc")) {
+			of_node_put(smc_node);
+			ret = -EINVAL;
+			goto out;
+		}
+		pdev = of_find_device_by_node(smc_node);
+		of_node_put(smc_node);
+		if (!pdev) {
+			ret = -EPROBE_DEFER;
+			goto out;
+		}
+		smc = platform_get_drvdata(pdev);
+		if (!smc) {
+			put_device(&pdev->dev);
+			ret = -EPROBE_DEFER;
+			goto out;
+		}
+		if (!dchid->afe_gpio) {
+			/* Reserve ownership without changing the inherited line state. */
+			gpio = devm_gpiod_get_index(dchid->dev, "apple,afe-reset", 0, GPIOD_ASIS);
+			if (IS_ERR(gpio)) {
+				ret = PTR_ERR(gpio);
+				put_device(&pdev->dev);
+				goto out;
+			}
+			dchid->afe_gpio = gpio;
+		}
+		link = device_link_add(dchid->dev, &pdev->dev, DL_FLAG_AUTOREMOVE_CONSUMER);
+		if (!link) {
+			put_device(&pdev->dev);
+			ret = -ENOMEM;
+			goto out;
+		}
+		ret = devm_add_action_or_reset(dchid->dev, dchid_put_afe_smc, &pdev->dev);
+		if (ret)
+			goto out;
+		dchid->afe_smc = smc;
+	}
+
+	ret = apple_smc_get_key_info(dchid->afe_smc, SMC_KEY(gP1c), &info);
+	if (ret < 0)
+		goto out;
+	dev_info(dchid->dev, "M4INPUT AFE key size=%u flags=0x%02x type=0x%08x\n",
+		 info.size, info.flags, info.type_code);
+	if (info.size != sizeof(__le32) || !(info.flags & APPLE_SMC_WRITABLE)) {
+		ret = -EINVAL;
+		goto out;
+	}
+	dchid->afe_ready = true;
+	ret = 0;
+out:
+	mutex_unlock(&dchid->afe_mutex);
+	if (ret)
+		dev_err(dchid->dev, "M4INPUT AFE action preparation failed: %d\n", ret);
+	return ret;
+}
+
+static int dchid_afe_write(struct dockchannel_hid *dchid, unsigned int argument)
+{
+	__le32 payload;
+	int ret;
+
+	if (!IS_REACHABLE(CONFIG_MFD_MACSMC))
+		return -EOPNOTSUPP;
+	lockdep_assert_held(&dchid->afe_mutex);
+	if (!dchid->afe_ready || !dchid->afe_smc || argument > 1)
+		return -EINVAL;
+
+	/* Board function template and argument; these are not GPIO voltage levels. */
+	payload = cpu_to_le32(0x00010000 | argument);
+	ret = apple_smc_write(dchid->afe_smc, SMC_KEY(gP1c), &payload, sizeof(payload));
+	dev_info(dchid->dev, "M4INPUT AFE action argument=%u result=%d\n", argument, ret);
+	if (ret < 0)
+		return ret;
+	if (argument == 1)
+		msleep(50);
+	return 0;
+}
+
+static int dchid_afe_action(struct dchid_iface *iface, int state)
+{
+	struct dockchannel_hid *dchid = iface->dchid;
+	int ret;
+
+	if (!dchid_afe_action_enabled(iface))
+		return 0;
+	if (state != 0 && state != 2)
+		return -EINVAL;
+
+	mutex_lock(&dchid->afe_mutex);
+	ret = dchid_afe_write(dchid, state == 0);
+	mutex_unlock(&dchid->afe_mutex);
+	return ret;
 }
 
