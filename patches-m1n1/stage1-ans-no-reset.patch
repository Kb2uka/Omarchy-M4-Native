+static void nvme_reset_ans(void)
+{
+    /*
+     * M4 (T8132): leave ANS asleep and stopped. A PMGR reset issued right after
+     * rtkit_sleep() stops the ANS CPU can wedge the machine on some units
+     * (J713, issue #82). Linux's apple-nvme driver resets the stopped ANS
+     * itself before booting it again.
+     */
+    if (nvme_type == NVME_T8132)
+        return;
+
+    // Some machines call this ANS, some ANS2...
+    pmgr_reset(nvme_die, "ANS");
+    pmgr_reset(nvme_die, "ANS2");
+}
+
 static void nvme_poll_syslog(void)
 {
