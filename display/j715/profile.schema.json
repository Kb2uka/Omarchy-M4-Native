{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-gated J715 native display profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "board", "soc", "synthetic", "qualification", "base_dtb_sha256", "firmware", "evidence", "resources", "interrupt_parent", "power", "stream", "dma", "protocol", "panel", "adt"],
  "properties": {
    "schema": {"const": 1},
    "board": {"const": "apple,j715"},
    "soc": {"const": "apple,t8132"},
    "synthetic": {"type": "boolean"},
    "qualification": {"enum": ["synthetic", "unqualified", "qualified"]},
    "base_dtb_sha256": {"$ref": "#/$defs/hash"},
    "firmware": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "sha256"],
      "properties": {"identity": {"type": "string", "minLength": 1, "maxLength": 128}, "sha256": {"$ref": "#/$defs/hash"}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["adt", "firmware", "panel", "protocol"],
      "properties": {
        "adt": {"$ref": "#/$defs/evidence"}, "firmware": {"$ref": "#/$defs/evidence"},
        "panel": {"$ref": "#/$defs/evidence"}, "protocol": {"$ref": "#/$defs/evidence"}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["dcp", "dart", "mailbox"],
      "properties": {
        "dcp": {"$ref": "#/$defs/resource"},
        "dart": {"$ref": "#/$defs/resource"},
        "mailbox": {"$ref": "#/$defs/resource"}
      }
    },
    "interrupt_parent": {
      "type": "object", "additionalProperties": false, "required": ["path", "compatible"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "compatible": {"const": "apple,t8132-aic3"}}
    },
    "power": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "label"],
        "properties": {"path": {"$ref": "#/$defs/path"}, "label": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"}}
      }
    },
    "stream": {"type": "integer", "minimum": 0, "maximum": 31},
    "dma": {
      "type": "object", "additionalProperties": false,
      "required": ["address_bits", "offset_bits", "page_shift", "table_levels"],
      "properties": {
        "address_bits": {"const": 42}, "offset_bits": {"const": 36},
        "page_shift": {"const": 14}, "table_levels": {"const": 3}
      }
    },
    "protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["endpoint", "channel", "service", "native"],
      "properties": {
        "endpoint": {"const": 35}, "channel": {"const": 3},
        "service": {"const": "disp0-service"}, "native": {"const": "afk-native-24-v1"}
      }
    },
    "panel": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "min_nits", "max_nits", "initial_nits"],
      "properties": {
        "identity": {"type": "string", "minLength": 1, "maxLength": 128},
        "min_nits": {"type": "integer", "minimum": 0, "maximum": 8388607},
        "max_nits": {"type": "integer", "minimum": 1, "maximum": 8388607},
        "initial_nits": {"type": "integer", "minimum": 0, "maximum": 8388607}
      }
    },
    "adt": {
      "type": "object", "additionalProperties": false, "required": ["nub", "dart"],
      "properties": {"nub": {"$ref": "#/$defs/path"}, "dart": {"$ref": "#/$defs/path"}}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^/[a-zA-Z0-9_@,/-]+$", "maxLength": 192},
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "pattern": "^evidence/[a-zA-Z0-9_./-]+$"}, "sha256": {"$ref": "#/$defs/hash"}}
    },
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "address", "size", "compatible", "interrupts", "roles", "power"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "address": {"type": "integer", "minimum": 1, "maximum": 4398046511103},
        "size": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "compatible": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9,-]+$"}},
        "interrupts": {"type": "array", "minItems": 0, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 65535}},
        "roles": {"type": "array", "minItems": 0, "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}},
        "power": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 7}}
      }
    }
  }
}
