post_install() {
  systemctl enable m4-backlight.service m4-backlight-display.service >/dev/null 2>&1 || true
  if [ -x usr/bin/python3 ]; then
    usr/bin/python3 usr/bin/m4-backlight --keys-hook || true
  fi
  printf '%s\n' '==> Native panel brightness starts after the next restart. Brightness keys keep their existing meaning.'
}

post_upgrade() {
  post_install
  # A backlight already running this boot follows the display now, with this
  # helper. Never start m4-backlight.service here: module startup belongs to boot.
  if systemctl is-active --quiet m4-backlight.service 2>/dev/null; then
    systemctl restart m4-backlight-display.service >/dev/null 2>&1 || true
  fi
}

pre_remove() {
  # Stopping the follower restores a level it is holding at zero.
  systemctl disable --now m4-backlight-display.service >/dev/null 2>&1 || true
  systemctl disable m4-backlight.service >/dev/null 2>&1 || true
  if [ -x usr/bin/python3 ]; then
    usr/bin/python3 usr/bin/m4-backlight --keys-remove-hook || true
  fi
}
