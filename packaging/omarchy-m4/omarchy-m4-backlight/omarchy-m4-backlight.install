post_install() {
  systemctl enable m4-backlight.service >/dev/null 2>&1 || true
  if [ -x usr/bin/python3 ]; then
    usr/bin/python3 usr/bin/m4-backlight --keys-hook || true
  fi
  printf '%s\n' '==> Native panel brightness starts after the next restart. Brightness keys keep their existing meaning.'
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl disable m4-backlight.service >/dev/null 2>&1 || true
  if [ -x usr/bin/python3 ]; then
    usr/bin/python3 usr/bin/m4-backlight --keys-remove-hook || true
  fi
}
