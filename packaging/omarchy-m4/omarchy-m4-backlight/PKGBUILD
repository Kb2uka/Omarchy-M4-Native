package() {
  install -Dm755 m4-backlight.py "$pkgdir/usr/bin/m4-backlight"
  install -Dm755 m4-j715-backlight "$pkgdir/usr/bin/m4-j715-backlight"
  local j715="$pkgdir/usr/lib/omarchy-m4/backlight/j715"
  install -Dm644 -t "$j715/tools" m4-j715-backlight.py m4-backlight.py j715_display_profile.py j715_sources.py
  install -Dm644 profile.schema.json "$j715/display/j715/profile.schema.json"
  install -Dm644 m4-j715-backlight.service "$pkgdir/usr/lib/systemd/system/m4-j715-backlight.service"
  install -Dm644 90-j715-backlight.rules "$pkgdir/usr/lib/udev/rules.d/90-j715-backlight.rules"
  install -Dm644 j713_dcp_backlight.ko "$pkgdir/usr/lib/omarchy-m4/backlight/j713_dcp_backlight.ko"
  install -Dm644 module.json "$pkgdir/usr/lib/omarchy-m4/backlight/module.json"
  install -Dm644 m4-backlight.service "$pkgdir/usr/lib/systemd/system/m4-backlight.service"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" NOTICE MIT.txt GPL-2.0-only.txt
}
