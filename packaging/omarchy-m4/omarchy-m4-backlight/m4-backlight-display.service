[Unit]
Description=Turn the J713 panel backlight off while its display is off
# Ordered after systemd-backlight so that, at shutdown, this stops first and
# restores the owner's level before systemd-backlight saves it.
After=m4-backlight.service systemd-backlight@backlight:j713-dcp.service
Requires=m4-backlight.service
ConditionPathExists=/sys/class/backlight/j713-dcp

[Service]
Type=exec
ExecStart=/usr/bin/m4-backlight --follow-display
# A follower killed while dark restarts and restores the level it published in /run.
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
