package() {
  install -Dm755 m4-headphones.py "$pkgdir/usr/bin/m4-headphones"
  install -Dm644 -t "$pkgdir/usr/lib/omarchy-m4/j713-headphones" j713_hp_dt.ko snd-soc-j713-headphones.ko
  install -Dm644 30-m4-headphones.conf \
    "$pkgdir/usr/lib/systemd/system/m4-j713-audio-register.service.d/30-m4-headphones.conf"
  install -Dm644 -t "$pkgdir/usr/share/alsa/ucm2/conf.d/J713Headphones" J713Headphones.conf HiFi.conf
  install -Dm644 83-j713-headphones.conf "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/83-j713-headphones.conf"
  install -Dm644 j713-headphones.lua "$pkgdir/usr/share/wireplumber/scripts/default-nodes/j713-headphones.lua"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" MIT.txt GPL-2.0-only.txt
}
