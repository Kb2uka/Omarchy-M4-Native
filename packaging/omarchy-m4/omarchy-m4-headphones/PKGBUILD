# staged from tools/, audio/j713/headphones/policy/ and LICENSES/ by
# tools/build-m4-packages.py. The module source is audio/j713/headphones/kernel/.
pkgname=omarchy-m4-headphones
pkgver=1
pkgrel=1
pkgdesc='J713 headphone jack playback: the J713Headphones card beside the protected speakers'
arch=('aarch64')
url='https://github.com/Kb2uka/Omarchy-M4-Native'
license=('GPL-2.0-only' 'MIT')
depends=('python' 'kmod')
install=omarchy-m4-headphones.install
options=('!strip' '!debug')
source=('m4-headphones.py' '30-m4-headphones.conf' 'J713Headphones.conf' 'HiFi.conf'
        '83-j713-headphones.conf' 'j713-headphones.lua' 'MIT.txt' 'GPL-2.0-only.txt'
        "j713_hp_dt.ko::${url}/releases/download/package-inputs/j713_hp_dt-9ba22f0e.ko"
        "snd-soc-j713-headphones.ko::${url}/releases/download/package-inputs/snd-soc-j713-headphones-a73ef565.ko")
sha256sums=('31f924d97860c0087b452bed8b931a656b259659afcf9c0c2ee03055d1c9022e'
            '2db802990b7514f3cd1f54168ce3c8adef9ec2dd061743d341490ee3985a9de2'
            '847dfe9dfe8f69877bfcb56ccd1f9c6425d9e28ba0ea826d96096152f7ce66b2'
            'b976cd08240b51065d8034dfd90ba79ae5ffc23c65ed83096ade1019a018bdb6'
            'f368ba0655235a6bf696332325ab2e9b5f9f3494b002a3c889e09e2553aa51c1'
            'af0653c5edcf2ef192925eb0d94b462065440d654812aa84a3b3198d671eb75d'
            'b05785f9f18e6716bab63424b11454513b9943a222595b70411009202fc592b5'
            'aaf135472f81c5b4a0dca9367e5bb5e9750032b5bebe5442b36e4c0a47430df3'
