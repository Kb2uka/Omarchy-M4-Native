post_install() {
  systemctl enable m4-cpu-idle.service >/dev/null 2>&1 || true
  echo '==> Restart once to let idle CPU cores power down and the P cores boost (m4-cpu-idle).'
}

post_upgrade() {
  post_install
  # Leave the marker for the boot helper to check against the shutdown journal.
  # Scriptlets run at the installation root, so the marker path is relative.
  if [ -e var/lib/omarchy-m4/cpu-idle/attempt ]; then
    echo '==> CPU idle is struck: a previous boot stopped while loading the driver.'
    echo '==> The next boot retries once if that boot shut down in order and no retry was already used.'
    echo '==> Otherwise, retry in the running session with: sudo m4-cpu-idle --start'
  fi
}

pre_remove() {
  systemctl disable m4-cpu-idle.service >/dev/null 2>&1 || true
  echo '==> A loaded CPU idle driver stays until the next restart.'
}
