package() {
  install -Dm755 m4-boot-compose.py "$pkgdir/usr/bin/m4-boot-compose"
  install -Dm644 90-omarchy-m4-boot.hook "$pkgdir/usr/share/libalpm/hooks/90-omarchy-m4-boot.hook"
  install -Dm755 m4-update-check.py "$pkgdir/usr/bin/omarchy-m4-update-check"
  install -Dm755 omarchy-m4-update "$pkgdir/usr/bin/omarchy-m4-update"
  install -Dm644 m4-channel-setup.py "$pkgdir/usr/lib/omarchy-m4/m4-channel-setup.py"
  install -Dm644 m4-lid-lock.py "$pkgdir/usr/lib/omarchy-m4/m4-lid-lock.py"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" omarchy-m4-update-check.service omarchy-m4-update-check.timer
  install -Dm644 j713-backlight.dtb "$pkgdir/usr/lib/omarchy-m4/j713.dtb"
  install -Dm644 Image-retained-bounds.gz "$pkgdir/usr/lib/omarchy-m4/retained-bounds/Image.gz"
  install -Dm755 m4-notch.py "$pkgdir/usr/bin/m4-notch"
  install -Dm644 stage2-hidden.bin "$pkgdir/usr/lib/omarchy-m4/backlight/stage2-hidden.bin"
  install -Dm644 stage2-shown.bin "$pkgdir/usr/lib/omarchy-m4/backlight/stage2-shown.bin"
  install -Dm644 omarchy-m4-notch.service "$pkgdir/usr/lib/systemd/user/omarchy-m4-notch.service"
  for notice in LICENSE README.md LICENSE.BSD-2.libfdt LICENSE.BSD-3.arm LICENSE.BSD-3.dwc3 LICENSE.CC0 \
                LICENSE.GPL-2 LICENSE.minlzma LICENSE.OFL-1.1 LICENSE.tinf; do
    install -Dm644 "m1n1-$notice" "$pkgdir/usr/share/licenses/$pkgname/m1n1/$notice"
  done
  install -Dm644 speakersafetyd-j713-realtime.conf \
    "$pkgdir/usr/lib/systemd/system/speakersafetyd-j713.service.d/50-realtime.conf"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" MIT.txt GPL-2.0-or-later.txt GPL-2.0-only.txt
}
