# m4-boot-compose.py, m4-update-check.py, m4-lid-lock.py, MIT.txt and GPL-2.0-or-later.txt are staged from tools/
# and LICENSES/ by tools/build-m4-packages.py.
pkgname=omarchy-m4-boot
pkgver=1
pkgrel=11
pkgdesc='Keeps the J713 boot.bin in step with the packaged M4 kernel and devicetree'
arch=('aarch64')
url='https://github.com/Kb2uka/Omarchy-M4-Native'
license=('MIT' 'GPL-2.0-or-later OR MIT')
# omarchy-m4-gpu (from 1-6), omarchy-m4-headphones (from 1-7) and omarchy-m4-cpu (from 1-10):
# an older installed setup script does not list them, so this pulls them in on the first
# omarchy-m4-update run that installs this version.
depends=('python' 'pacman' 'omarchy-m4-gpu' 'omarchy-m4-headphones' 'omarchy-m4-cpu')
install=omarchy-m4-boot.install
options=('!strip' '!debug')
# The CPU frequency, CPU temperature, CPU thermal zone and boost-state devicetree, with P
# held at 1800 MHz behind the boost gate until j713_pguard opens it (docs/j713-cpu-boost.md),
# and the real-time speaker protection setting it needs (docs/j713-cpufreq.md, "All three parts").
source=('m4-boot-compose.py' '90-omarchy-m4-boot.hook' 'm4-update-check.py'
        'omarchy-m4-update-check.service' 'omarchy-m4-update-check.timer' 'MIT.txt' 'GPL-2.0-or-later.txt'
        'speakersafetyd-j713-realtime.conf' 'm4-channel-setup.py' 'omarchy-m4-update' 'm4-lid-lock.py'
        "j713-pboost.dtb::${url}/releases/download/package-inputs/j713-pboost.dtb")
sha256sums=('f1aabd31099ea5abc5db99b3dfb2c3c42b605d7eba7163d73786df3b1c2312f7'
            '22514358734721ffcb4478f9c3c2c91f55b858bbd40aba6278c395e7a35de810'
            'bf06541caba3709e81b261c60563886e95fff902d811b74f2b49c03e70ee1685'
            '8ecdbfc8303276d8db5922f6a06aa945f58ebca27b83520f76e9155561b9c5b0'
            '2e920a979cdf4d8d2075f9f3ab513c5e614eaa126f74b2c01ea5ccf0ab8a9544'
            'b05785f9f18e6716bab63424b11454513b9943a222595b70411009202fc592b5'
            'aaf135472f81c5b4a0dca9367e5bb5e9750032b5bebe5442b36e4c0a47430df3'
            'a116d5a6aa09bc2aec1393ef737f21d9cc0eaac474615cb215f48491b7db8a56'
            '472c583b4bbc6125df9beda80e6a381934d0d9485554f8a8e851da2bc3a20c41'
            'bde52f8012b209e06c0e2b41325413c642ae4c6e6eedce7ff04331ca4d50c0f1'
            'f605580fc7e8e672cee85f5afee930550b8f445f026b5a04c1828e52c88ea6de'
            'c4f036b819ce757ce790b01779a3f7532eacd5cb1c1097fa20286d1a9c9ec6ca')

package() {
  install -Dm755 m4-boot-compose.py "$pkgdir/usr/bin/m4-boot-compose"
  install -Dm644 90-omarchy-m4-boot.hook "$pkgdir/usr/share/libalpm/hooks/90-omarchy-m4-boot.hook"
  install -Dm755 m4-update-check.py "$pkgdir/usr/bin/omarchy-m4-update-check"
  install -Dm755 omarchy-m4-update "$pkgdir/usr/bin/omarchy-m4-update"
  install -Dm644 m4-channel-setup.py "$pkgdir/usr/lib/omarchy-m4/m4-channel-setup.py"
  install -Dm644 m4-lid-lock.py "$pkgdir/usr/lib/omarchy-m4/m4-lid-lock.py"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" omarchy-m4-update-check.service omarchy-m4-update-check.timer
  install -Dm644 j713-pboost.dtb "$pkgdir/usr/lib/omarchy-m4/j713.dtb"
  install -Dm644 speakersafetyd-j713-realtime.conf \
    "$pkgdir/usr/lib/systemd/system/speakersafetyd-j713.service.d/50-realtime.conf"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" MIT.txt GPL-2.0-or-later.txt
}
