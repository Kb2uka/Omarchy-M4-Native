# m4-boot-compose.py, m4-update-check.py, MIT.txt and GPL-2.0-or-later.txt are staged from tools/
# and LICENSES/ by tools/build-m4-packages.py.
pkgname=omarchy-m4-boot
pkgver=1
pkgrel=5
pkgdesc='Keeps the J713 boot.bin in step with the packaged M4 kernel and devicetree'
arch=('aarch64')
url='https://github.com/Kb2uka/Omarchy-M4-Native'
license=('MIT' 'GPL-2.0-or-later OR MIT')
depends=('python' 'pacman')
install=omarchy-m4-boot.install
options=('!strip' '!debug')
# The CPU frequency and CPU temperature devicetree (docs/j713-cpu-temperature.md), and the
# real-time speaker protection setting it needs (docs/j713-cpufreq.md, "All three parts").
source=('m4-boot-compose.py' '90-omarchy-m4-boot.hook' 'm4-update-check.py'
        'omarchy-m4-update-check.service' 'omarchy-m4-update-check.timer' 'MIT.txt' 'GPL-2.0-or-later.txt'
        'speakersafetyd-j713-realtime.conf' 'm4-channel-setup.py' 'omarchy-m4-update'
        "j713-cputemp.dtb::${url}/releases/download/package-inputs/j713-cputemp.dtb")
sha256sums=('67cbbe056e4e7b9193e3648ebfff78ae68316ca50a47e2676cd62c36a7918630'
            '22514358734721ffcb4478f9c3c2c91f55b858bbd40aba6278c395e7a35de810'
            'bf06541caba3709e81b261c60563886e95fff902d811b74f2b49c03e70ee1685'
            '8ecdbfc8303276d8db5922f6a06aa945f58ebca27b83520f76e9155561b9c5b0'
            '2e920a979cdf4d8d2075f9f3ab513c5e614eaa126f74b2c01ea5ccf0ab8a9544'
            'b05785f9f18e6716bab63424b11454513b9943a222595b70411009202fc592b5'
            'aaf135472f81c5b4a0dca9367e5bb5e9750032b5bebe5442b36e4c0a47430df3'
            'a116d5a6aa09bc2aec1393ef737f21d9cc0eaac474615cb215f48491b7db8a56'
