# Maintainer: KB2UKA
# Built and signed by .github/workflows/packages.yml; see docs/package-channel.md.
# m4-boot-compose.py, m4-update-check.py, m4-lid-lock.py, m4-notch.py, MIT.txt,
# GPL-2.0-or-later.txt and GPL-2.0-only.txt are staged from tools/ and LICENSES/,
# and the m1n1-* notices from display/j713/m1n1-base/, by tools/build-m4-packages.py.
pkgname=omarchy-m4-boot
pkgver=1
pkgrel=18
pkgdesc='Keeps the J713 boot.bin in step with the packaged M4 kernel and devicetree'
arch=('aarch64')
url='https://github.com/Kb2uka/Omarchy-M4-Native'
# The notch stage 2 is an m1n1 build: MIT, with the embedded parts its README lists.
# GPL-2.0-only covers the retained-bounds kernel image staged beside the base package.
license=('MIT' 'GPL-2.0-only' 'GPL-2.0-or-later OR MIT' 'BSD-2-Clause OR GPL-2.0-or-later' 'BSD-3-Clause' 'Zlib' 'CC0-1.0' 'OFL-1.1')
# omarchy-m4-gpu (from 1-6), omarchy-m4-headphones (from 1-7), omarchy-m4-cpu (from 1-10) and
# omarchy-m4-evdi (from 1-13) and omarchy-m4-backlight (from 1-14): an older
# installed setup script does not list them, so this pulls them in on the first
# omarchy-m4-update run that installs this version.
# omarchy-m4-speaker>=1-4 (from 1-18): an older setup request omits the speaker
# package, 1-1 does not stage the fixed MCA module, and 1-2 still requires the
# manifest to match one exact byte layout. 1-4 validates the stock backup
# before accepting a rollback request and reports held recovery accurately.
# Boot 1-18 preserves boot holds and newer installed channel packages.
depends=('python' 'pacman' 'omarchy-m4-gpu' 'omarchy-m4-headphones' 'omarchy-m4-cpu' 'omarchy-m4-evdi' 'omarchy-m4-backlight' 'omarchy-m4-speaker>=1-4')
install=omarchy-m4-boot.install
options=('!strip' '!debug')
# The CPU frequency, CPU temperature, CPU thermal zone and boost-state devicetree, with P
# held at 1800 MHz behind the boost gate until j713_pguard opens it (docs/j713-cpu-boost.md),
# with the front USB-C port turned on like the hinge-side one (docs/j713-front-usb.md),
# and the real-time speaker protection setting it needs (docs/j713-cpufreq.md, "All three parts").
source=('m4-boot-compose.py' '90-omarchy-m4-boot.hook' 'm4-update-check.py'
        'omarchy-m4-update-check.service' 'omarchy-m4-update-check.timer' 'MIT.txt' 'GPL-2.0-or-later.txt'
        'GPL-2.0-only.txt'
        'speakersafetyd-j713-realtime.conf' 'm4-channel-setup.py' 'omarchy-m4-update' 'm4-lid-lock.py'
        "j713-backlight.dtb::${url}/releases/download/package-inputs/j713-backlight-afb025a8.dtb"
        "Image-retained-bounds.gz::${url}/releases/download/package-inputs/j713-retained-bounds-ca1fff57-Image.gz"
        'm4-notch.py' 'omarchy-m4-notch.service'
        # Both notch preferences retain the native panel's per-boot display handoff.
        "stage2-hidden.bin::${url}/releases/download/package-inputs/j713-m1n1-stage2-backlight-b86aee68.bin"
        "stage2-shown.bin::${url}/releases/download/package-inputs/j713-m1n1-stage2-backlight-notch-692f656c.bin"
        'm1n1-LICENSE' 'm1n1-README.md' 'm1n1-LICENSE.BSD-2.libfdt' 'm1n1-LICENSE.BSD-3.arm'
        'm1n1-LICENSE.BSD-3.dwc3' 'm1n1-LICENSE.CC0' 'm1n1-LICENSE.GPL-2' 'm1n1-LICENSE.minlzma'
        'm1n1-LICENSE.OFL-1.1' 'm1n1-LICENSE.tinf')
