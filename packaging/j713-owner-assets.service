[Unit]
Description=Install M4 Air owner options
Before=systemd-user-sessions.service omarchy-provision-owner.service getty.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /usr/lib/omarchy/m4-j713-owner-assets.py install
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
