+# SPDX-License-Identifier: MIT
+"""Compose one Linux initramfs from portable files and locally collected firmware."""
+import hashlib
+import re
+import struct
+
+LIMITS = {"loader": 4 << 20, "kernel": 64 << 20, "dtb": 2 << 20,
+          "initramfs": 128 << 20}
+MAGIC = b"m1n1_initramfs"
+
+
+def validate_spec(spec):
+    if not isinstance(spec, dict) or set(spec) != set(LIMITS) | {"bootargs"}:
+        raise ValueError("M4 boot description must specify four parts and bootargs")
+    args = spec["bootargs"]
+    if (not isinstance(args, str) or not 0 < len(args) <= 1024 or not args.isascii()
+            or any(ord(char) < 32 or ord(char) == 127 for char in args)):
+        raise ValueError("M4 bootargs must be one printable ASCII line")
+    for name in LIMITS:
+        part = spec[name]
+        if (not isinstance(part, dict) or set(part) != {"file", "sha256"}
+                or not isinstance(part["file"], str) or not part["file"]
+                or not isinstance(part["sha256"], str)
+                or not re.fullmatch(r"[0-9a-f]{64}", part["sha256"])):
+            raise ValueError(f"Invalid M4 boot part: {name}")
+
+
+def read_parts(package, spec):
+    validate_spec(spec)
+    parts = {}
+    for name, limit in LIMITS.items():
+        entry = spec[name]
+        info = package.getinfo(entry["file"])
+        if not 0 < info.file_size <= limit:
+            raise ValueError(f"Invalid M4 boot part size: {name}")
+        data = package.read(info)
+        if hashlib.sha256(data).hexdigest() != entry["sha256"]:
+            raise ValueError(f"M4 boot part checksum mismatch: {name}")
+        parts[name] = data
+    if not parts["kernel"].startswith(b"\x1f\x8b"):
+        raise ValueError("M4 kernel must be gzip compressed")
+    if not parts["initramfs"].startswith(b"\x1f\x8b"):
+        raise ValueError("M4 base initramfs must be gzip compressed")
+    dtb = parts["dtb"]
+    if (len(dtb) < 40 or dtb[:4] != b"\xd0\x0d\xfe\xed"
+            or struct.unpack_from(">I", dtb, 4)[0] != len(dtb)):
+        raise ValueError("Invalid M4 device tree header or length")
+    return parts
+
+
+def compose(parts, bootargs, firmware):
+    # Firmware is produced by FWPackage in this installation, never downloaded
+    # in the portable image. Its trailer resets CPIO hard-link inode tracking.
+    if (not firmware or len(firmware) > 128 << 20
+            or not firmware.startswith(b"070701")
+            or b"TRAILER!!!\0" not in firmware[-124:]):
+        raise ValueError("Locally collected firmware is not a complete newc archive")
+    base = parts["initramfs"]
+    initramfs = base + bytes(-len(base) % 4) + firmware
+    # Stage 1 appends the selected partition identities here before adding its
+    # terminator. An earlier terminator would hide those variables from stage 2.
+    return (parts["loader"] + ("chosen.bootargs=" + bootargs + "\n").encode("ascii")
+            + parts["kernel"] + parts["dtb"]
+            + MAGIC + struct.pack("<I", len(initramfs)) + initramfs)
