@@ -0,0 +1,319 @@
+# SPDX-License-Identifier: MIT
+import contextlib
+import copy
+import io
+import os
+import struct
+from pathlib import Path
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import Mock, patch
+import uuid
+import zipfile
+
+import m1n1
+from osinstall import OSInstaller
+
+ROOT_TYPE = "0fc63daf-8483-4772-8e79-3d69d8477de4"
+FS_UUID = "61924e2a-307d-4f34-9b04-4eef87d46729"
+PART_UUID = "cb2e29b7-ff84-41cc-a30f-b9c91b81e9ca"
+EFI_UUID = "5870193f-b249-4d1e-ae24-c3a3fb0ebd9a"
+
+
+def template():
+    return {"default_os_name": "Omarchy fixture", "package": "root.zip",
+            "boot_object": "stage1.bin", "next_object": "omarchy/boot.bin",
+            "partitions": [
+                {"name": "EFI", "type": "EFI", "size": "1MiB", "format": "fat"},
+                {"name": "Root", "type": ROOT_TYPE, "size": "1MiB", "image": "root.ext4",
+                 "rootfs_uuid": FS_UUID, "expand": True},
+            ]}
+
+
+def filesystem(fs_uuid=FS_UUID):
+    data = bytearray(4096)
+    data[1024 + 56:1024 + 58] = b"\x53\xef"
+    struct.pack_into("<H", data, 1024 + 58, 1)
+    data[1024 + 104:1024 + 120] = uuid.UUID(fs_uuid).bytes
+    return data
+
+
+class RootIdentityTests(unittest.TestCase):
+    def setUp(self):
+        directory = tempfile.TemporaryDirectory(prefix="root identity ")
+        self.addCleanup(directory.cleanup)
+        self.root = Path(directory.name)
+        self.dutil = Mock()
+        self.stack = contextlib.ExitStack()
+        self.addCleanup(self.stack.close)
+        self.stack.enter_context(patch.dict(os.environ, {"REPO_BASE": str(self.root)}))
+        self.stack.enter_context(contextlib.redirect_stdout(io.StringIO()))
+        (self.root / "os").mkdir()
+
+    def package(self, data, parts=None):
+        with zipfile.ZipFile(self.root / "os/root.zip", "w") as archive:
+            archive.writestr("root.ext4", data)
+            for name, content in (parts or {}).items():
+                archive.writestr("boot/" + name, content)
+
+    def installer(self, config=None):
+        obj = OSInstaller(self.dutil, {}, config if config is not None else template())
+        # Close any archive even if validation rejects its contents.
+        self.addCleanup(lambda: obj.pkg.close() if getattr(obj, "pkg", None) is not None else None)
+        return obj
+
+    def test_rejects_invalid_template_before_any_disk_call(self):
+        invalid = []
+        for value in ("", "not-a-uuid", FS_UUID.replace("-", ""), None, 7):
+            config = template()
+            config["partitions"][1]["rootfs_uuid"] = value
+            invalid.append(config)
+        config = template()
+        config["partitions"].append(copy.deepcopy(config["partitions"][1]))
+        invalid.append(config)
+        for field, value in (("type", "Apple_APFS"), ("image", "")):
+            config = template()
+            config["partitions"][1][field] = value
+            invalid.append(config)
+        config = template()
+        config["partitions"].pop(0)
+        invalid.append(config)
+        for config in invalid:
+            with self.subTest(config=config), self.assertRaises(ValueError):
+                self.installer(config)
+        self.assertEqual(self.dutil.mock_calls, [])
+
+    def test_rejects_wrong_image_identity_before_disk_calls(self):
+        wrong_magic = filesystem()
+        wrong_magic[1024 + 56:1024 + 58] = bytes(2)
+        for data in (filesystem(EFI_UUID), wrong_magic, bytearray(4096), filesystem()[:1080],
+                     filesystem() + b"unaligned"):
+            with self.subTest(size=len(data)):
+                self.package(data)
+                obj = self.installer()
+                with self.assertRaises(ValueError):
+                    obj.load_package()
+                self.assertIsNone(obj.pkg.fp)
+                self.assertEqual(self.dutil.mock_calls, [])
+
+    def test_rejects_image_larger_than_initial_root_partition(self):
+        self.package(filesystem() + bytes(1024 * 1024))
+        obj = self.installer()
+        with self.assertRaises(ValueError):
+            obj.load_package()
+        self.assertEqual(self.dutil.mock_calls, [])
+
+    def test_accepts_matching_ext4_before_disk_calls(self):
+        self.package(filesystem())
+        obj = self.installer()
+        obj.load_package()
+        self.assertEqual(self.dutil.mock_calls, [])
+
+    def test_rejects_unchecked_or_unclean_image_before_disk_calls(self):
+        for state, mounted, checked in ((0, 0, 0), (2, 0, 0), (3, 0, 0),
+                                        (1, 1700000001, 1700000000),
+                                        (1, 1700000256, 1700000255)):
+            with self.subTest(state=state, mounted=mounted, checked=checked):
+                data = filesystem()
+                struct.pack_into("<H", data, 1024 + 58, state)
+                struct.pack_into("<I", data, 1024 + 44, mounted)
+                struct.pack_into("<I", data, 1024 + 64, checked)
+                self.package(data)
+                obj = self.installer()
+                with self.assertRaises(ValueError):
+                    obj.load_package()
+                self.assertIsNone(obj.pkg.fp)
+                self.assertEqual(self.dutil.mock_calls, [])
+
+    def test_accepts_image_checked_at_or_after_last_mount(self):
+        for mounted, checked in ((0, 1700000000), (1700000000, 1700000000),
+                                  (1700000000, 1700000001),
+                                  (1700000255, 1700000256)):
+            with self.subTest(mounted=mounted, checked=checked):
+                data = filesystem()
