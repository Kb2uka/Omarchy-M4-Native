+    def test_install_seals_created_partition_and_image_identity(self):
+        self.package(filesystem())
+        obj = self.installer()
+        obj.load_package()
+        efi = SimpleNamespace(name="disk0s4", uuid=EFI_UUID.upper(), size=1024 * 1024)
+        root = SimpleNamespace(name="disk0s5", uuid=PART_UUID.upper(), size=1024 * 1024)
+        obj.part_info, obj.efi_part = [efi, root], efi
+        self.dutil.get_partition_info.return_value = root
+        (self.root / "boot").mkdir()
+        (self.root / "boot/stage1.bin").write_bytes(b"fixture-stage-oneSTACKBOT")
+        target = self.root / "raw-partition"
+        target.write_bytes(bytes(8192))
+        boot_object = self.root / "boot-object.bin"
+        original_open = open
+        def scratch_open(path, *args, **kwargs):
+            if str(path).startswith("/dev/"):
+                self.assertEqual(str(path), "/dev/rdisk0s5")
+                return original_open(target, *args, **kwargs)
+            return original_open(path, *args, **kwargs)
+        previous = Path.cwd()
+        try:
+            os.chdir(self.root)
+            with patch("builtins.open", side_effect=scratch_open):
+                obj.install(SimpleNamespace(boot_obj_path=boot_object))
+        finally:
+            os.chdir(previous)
+        self.assertEqual(target.read_bytes()[:4096], filesystem())
+        self.assertEqual(m1n1.extract_vars(boot_object), [
+            "chosen.gravity,efi-system-partition=" + EFI_UUID,
+            "chainload=" + EFI_UUID + ";omarchy/boot.bin",
+            "chosen.omarchy,root-partition=" + PART_UUID,
+            "chosen.omarchy,root-filesystem=" + FS_UUID,
+        ])
+        self.assertEqual(boot_object.stat().st_size % 65536, 0)
