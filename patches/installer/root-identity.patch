diff --git i/tests/test_m4_boot_package.py w/tests/test_m4_boot_package.py
new file mode 100644
index 0000000..7b21a9d
--- /dev/null
+++ w/tests/test_m4_boot_package.py
@@ -0,0 +1,147 @@
+# SPDX-License-Identifier: MIT
+import copy
+import gzip
+import hashlib
+import io
+from pathlib import Path
+import struct
+import tempfile
+import unittest
+import zipfile
+import zlib
+
+import m4boot
+from gravity_firmware.core import FWFile, FWPackage
+from test_m4_firmware import read_newc
+
+
+def boot_parts():
+    dtb = b"\xd0\x0d\xfe\xed" + struct.pack(">I", 40) + bytes(32)
+    parts = {"loader": b"fixture-loaderSTACKBOT", "kernel": gzip.compress(b"kernel fixture"),
+             "dtb": dtb, "initramfs": gzip.compress(b"base archive fixture!")}
+    spec = {name: {"file": "boot/" + name, "sha256": hashlib.sha256(data).hexdigest()}
+            for name, data in parts.items()}
+    spec["bootargs"] = "console=tty0 loglevel=4"
+    return parts, spec
+
+
+class M4BootTests(unittest.TestCase):
+    def setUp(self):
+        directory = tempfile.TemporaryDirectory(prefix="M4 boot package ")
+        self.addCleanup(directory.cleanup)
+        self.root = Path(directory.name)
+        self.parts, self.spec = boot_parts()
+        self.assertNotEqual(len(self.parts["initramfs"]) % 4, 0)
+
+    def read_parts(self, parts=None, spec=None):
+        source = io.BytesIO()
+        with zipfile.ZipFile(source, "w") as package:
+            for name, data in (self.parts if parts is None else parts).items():
+                package.writestr("boot/" + name, data)
+        with zipfile.ZipFile(source) as package:
+            return m4boot.read_parts(package, self.spec if spec is None else spec)
+
+    def test_all_portable_parts_are_hash_checked(self):
+        self.assertEqual(self.read_parts(), self.parts)
+        for name in self.parts:
+            for operation in ("changed", "missing", "empty"):
+                with self.subTest(name=name, operation=operation):
+                    parts = dict(self.parts)
+                    if operation == "missing":
+                        del parts[name]
+                    else:
+                        parts[name] = b"" if operation == "empty" else parts[name] + b"changed"
+                    with self.assertRaises((ValueError, KeyError)):
+                        self.read_parts(parts)
+
+    def test_part_limits_and_formats(self):
+        for name in self.parts:
+            with self.subTest(name=name):
+                from unittest.mock import patch
+                with patch.dict(m4boot.LIMITS, {name: len(self.parts[name]) - 1}):
+                    with self.assertRaises(ValueError):
+                        self.read_parts()
+        for name, data in (("kernel", b"raw"), ("initramfs", b"raw"),
+                           ("dtb", self.parts["dtb"][:-1]), ("dtb", bytes(40)),
+                           ("dtb", self.parts["dtb"] + bytes(8))):
+            with self.subTest(name=name, data=data):
+                parts, spec = dict(self.parts), copy.deepcopy(self.spec)
+                parts[name] = data
+                spec[name]["sha256"] = hashlib.sha256(data).hexdigest()
+                with self.assertRaises(ValueError):
+                    self.read_parts(parts, spec)
+
+    def test_template_rejects_incomplete_parts_and_variable_injection(self):
+        for args in ("", "console=tty0\nchainload=other", "\0", "\r", "\x7f", "é", 7, "x" * 1025):
+            with self.subTest(args=args), self.assertRaises(ValueError):
+                m4boot.validate_spec(dict(self.spec, bootargs=args))
+        m4boot.validate_spec(dict(self.spec, bootargs="x" * 1024))
+        for name in self.parts:
+            spec = copy.deepcopy(self.spec)
+            del spec[name]
+            with self.subTest(name=name), self.assertRaises(ValueError):
+                m4boot.validate_spec(spec)
+            spec = copy.deepcopy(self.spec)
+            spec[name]["sha256"] = "invalid"
+            with self.subTest(name=name), self.assertRaises(ValueError):
+                m4boot.validate_spec(spec)
+
+    def test_one_initramfs_contains_base_and_actual_firmware_writer_output(self):
+        with FWPackage(self.root) as package:
+            package.add_file("apple/tpmtfw-j713.bin", FWFile("touch", b"touch fixture"))
+            package.add_file("apple/alias.bin", FWFile("alias", b"touch fixture"))
+        firmware = (self.root / "firmware.cpio").read_bytes()
+        payload = m4boot.compose(self.parts, self.spec["bootargs"], firmware)
+        prefix = (self.parts["loader"] + b"chosen.bootargs=console=tty0 loglevel=4\n"
+                  + self.parts["kernel"] + self.parts["dtb"])
+        self.assertEqual(payload[:len(prefix)], prefix)
+        header = len(prefix)
+        self.assertEqual(payload[header:header + 14], b"m1n1_initramfs")
+        length = struct.unpack_from("<I", payload, header + 14)[0]
+        combined = payload[header + 18:header + 18 + length]
+        self.assertEqual(payload[header + 18 + length:], b"")
+        decoder = zlib.decompressobj(16 + zlib.MAX_WBITS)
+        self.assertEqual(decoder.decompress(combined), b"base archive fixture!")
+        self.assertTrue(decoder.eof)
+        end = len(combined) - len(decoder.unused_data)
+        aligned = (end + 3) & ~3
+        self.assertEqual(combined[end:aligned], bytes(aligned - end))
+        self.assertEqual(combined[aligned:], firmware)
+        recovered = self.root / "recovered.cpio"
+        recovered.write_bytes(combined[aligned:])
+        entries = read_newc(recovered)
+        self.assertEqual(entries["vendorfw/apple/tpmtfw-j713.bin"], b"touch fixture")
+        # The writer encodes its second identical file as a zero-data hard link.
+        self.assertEqual(entries["vendorfw/apple/alias.bin"], b"")
+        self.assertIn("vendorfw/.vendorfw.manifest", entries)
+
+    def test_stage_one_variables_are_immediately_after_the_initramfs(self):
+        with FWPackage(self.root) as package:
+            package.add_file("apple/tpmtfw-j713.bin", FWFile("touch", b"touch fixture"))
+        payload = m4boot.compose(self.parts, self.spec["bootargs"],
+                                 (self.root / "firmware.cpio").read_bytes())
+        variables = (b"chosen.omarchy,root-partition=cb2e29b7-ff84-41cc-a30f-b9c91b81e9ca\n"
+                     b"chosen.omarchy,root-filesystem=61924e2a-307d-4f34-9b04-4eef87d46729\n"
+                     b"chosen.gravity,efi-system-partition=5870193f-b249-4d1e-ae24-c3a3fb0ebd9a\n")
+        # chainload_image appends chosen variables at the end of the disk file,
+        # then its own four-byte terminator. load_cpio advances by header size.
+        chained = payload + variables + bytes(4)
+        header = len(self.parts["loader"]) + len(("chosen.bootargs=" + self.spec["bootargs"] + "\n").encode())
+        header += len(self.parts["kernel"]) + len(self.parts["dtb"])
+        next_offset = header + 18 + struct.unpack_from("<I", chained, header + 14)[0]
+        self.assertEqual(chained[next_offset:], variables + bytes(4))
+
+    def test_incomplete_firmware_rejects(self):
+        for data in (b"", b"070701incomplete", b"not-newcTRAILER!!!\0"):
+            with self.subTest(data=data), self.assertRaises(ValueError):
+                m4boot.compose(self.parts, self.spec["bootargs"], data)
+
+    def test_oversize_firmware_with_valid_boundary_markers_rejects(self):
+        data = b"070701" + bytes((128 << 20) - 16) + b"TRAILER!!!\0"
+        self.assertGreater(len(data), 128 << 20)
+        with self.assertRaises(ValueError):
+            m4boot.compose(self.parts, self.spec["bootargs"], data)
+
+
+if __name__ == "__main__":
+    unittest.main()
