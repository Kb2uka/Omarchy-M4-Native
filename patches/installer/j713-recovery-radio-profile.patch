@@ -0,0 +1,167 @@
+# SPDX-License-Identifier: MIT
+import contextlib
+import io
+import os
+from pathlib import Path
+import plistlib
+import tarfile
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import Mock, patch
+import zipfile
+import zlib
+
+import stub
+from gravity_firmware import update
+from gravity_firmware.core import FWFile, FWPackage
+import validate_j713_recovery_macos as validator
+
+
+class NativeObserverTests(unittest.TestCase):
+    def test_cached_recovery_size_checked_independently(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            cached = Path(tmp) / "cached.aea"
+            cached.write_bytes(b"qualified bytes")
+            archive = Mock()
+            archive.getinfo.return_value = SimpleNamespace(
+                file_size=cached.stat().st_size + 1,
+                CRC=zlib.crc32(cached.read_bytes()))
+            with self.assertRaisesRegex(ValueError, "cached recovery"):
+                validator.CachedRecoveryPackage(archive, cached)
+
+    def test_cached_recovery_must_match_archive_member(self):
+        member = "022-21678-093.dmg.aea"
+        with tempfile.TemporaryDirectory() as tmp:
+            cached = Path(tmp) / member
+            stream = io.BytesIO()
+            with zipfile.ZipFile(stream, "w") as archive:
+                archive.writestr(member, b"qualified bytes")
+            with zipfile.ZipFile(stream) as archive:
+                for data in (b"qualified bytes", b"wrong", b"different bytes"):
+                    cached.write_bytes(data)
+                    with self.subTest(data=data):
+                        if data == b"qualified bytes":
+                            package = validator.CachedRecoveryPackage(archive, cached)
+                            with package.open(member) as source:
+                                self.assertEqual(source.read(), data)
+                        else:
+                            with self.assertRaisesRegex(ValueError, "cached recovery"):
+                                validator.CachedRecoveryPackage(archive, cached)
+
+    def test_native_require_rejects_false_without_assert(self):
+        with self.assertRaisesRegex(ValueError, "sentinel"):
+            validator.require(False, "sentinel")
+        validator.require(True, "sentinel")
+
+
+class InstallerRadioDispatchTests(unittest.TestCase):
+    def test_preflight_uses_identity_machine(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            mount = Path(tmp)
+            version = mount / "System/Library/CoreServices/SystemVersion.plist"
+            version.parent.mkdir(parents=True)
+            version.write_bytes(plistlib.dumps({"ProductVersion": "26.5.1"}))
+            obj = stub.StubInstaller(None, None, None)
+            obj.install_version = "26.5.1"
+            obj.load_identity = Mock(return_value={"Info": {"DeviceClass": "j713ap"},
+                "Manifest": {"BaseSystem": {"Info": {"Path": "fixture.aea"}}}})
+            obj.recovery_wifi_source = Mock(return_value="fixture-wifi")
+            with patch.object(stub, "RecoveryImage"), \
+                 patch.object(stub, "mounted_recovery", return_value=contextlib.nullcontext(mount)), \
+                 patch.object(stub, "WiFiFWCollection") as wifi, \
+                 patch.object(stub, "BluetoothFWCollection") as bluetooth, \
+                 contextlib.redirect_stdout(io.StringIO()):
+                obj.preflight_recovery()
+            wifi.assert_called_once_with("fixture-wifi", machine="j713")
+            bluetooth.assert_called_once_with(str(mount / "usr/share/firmware/bluetooth"), machine="j713")
+
+    def test_complete_collector_dispatches_air_radio(self):
+        with tempfile.TemporaryDirectory() as tmp, contextlib.ExitStack() as stack:
+            mount = Path(tmp) / "recovery"
+            mount.mkdir()
+            previous = Path.cwd()
+            stack.callback(os.chdir, previous)
+            os.chdir(tmp)
+            obj = stub.StubInstaller(None, None, None)
+            obj.identity = {"Info": {"DeviceClass": "j713ap", "RestoreBehavior": "Erase", "Variant": "fixture"}, "Manifest": {"Fixture": {"Info": {"Path": "fixture.im4p", "IsFUDFirmware": True}}}}
+            obj.behavior, obj.variant = "Erase", "fixture"
+            obj.pb_vgid = tmp
+            obj.osi = SimpleNamespace(recovery=tmp, vgid="fixture")
+            obj.restore_bundle_path = Mock(return_value="restore")
