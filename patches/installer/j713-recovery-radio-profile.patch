+# SPDX-License-Identifier: MIT
+import contextlib
+import io
+from pathlib import Path
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import Mock, patch
+
+import main
+import recovery
+from stub import StubInstaller
+from gravity_firmware import update
+from gravity_firmware.bluetooth import BluetoothFWCollection
+from gravity_firmware.open_firmware import OpenFirmwareCollection
+from gravity_firmware.wifi import WiFiFWCollection
+
+
+WIFI = {
+    "brcm/brcmfmac4388c2-pcie.apple,garden.bin": "garden.trx",
+    "brcm/brcmfmac4388c2-pcie.apple,garden.clm_blob": "garden.clmb",
+    "brcm/brcmfmac4388c2-pcie.apple,garden.txcap_blob": "garden.txcb",
+    "brcm/brcmfmac4388c2-pcie.apple,garden.sig": "garden.sig",
+    "brcm/brcmfmac4388c2-pcie.apple,garden-WLMT-a.txt": "P-garden_M-WLMT_V-a__m-4.9.txt",
+    "brcm/brcmfmac4388c2-pcie.apple,garden-WLMT-u.txt": "P-garden_M-WLMT_V-u__m-4.9.txt",
+}
+BT = {
+    "brcm/brcmbt4388c2-apple,garden-u.bin": "BCM4388C2_23.5.224.1477_PCIE_macOS_Willamette_Garden_CLPC_OS_USI_20251203.bin",
+    "brcm/brcmbt4388c2-apple,garden-u.ptb": "BCM4388C2_P1v1_PCIE_macOS_Willamette_Garden_CLPC_OS_USI_K_R_20240524.ptb",
+    "brcm/brcmbt4388c2-apple,garden-a.bin": "BCM4388C2_23.5.224.1476_PCIE_macOS_Willamette_Garden_CLPC_OS_AMKOR_20251203.bin",
+    "brcm/brcmbt4388c2-apple,garden-a.ptb": "BCM4388C2_P1v1_PCIE_macOS_Willamette_Garden_CLPC_OS_AMKOR_K_R_20240524.ptb",
+}
+
+
+class AirProfileTests(unittest.TestCase):
+    def test_experimental_main_entry_reaches_menu(self):
+        for device, expert, version, succeeds in (
+            ("j713ap", True, "26.5.1", True),
+            ("j713ap", False, "26.5.1", False),
+            ("j773gap", False, "26.6.2", True),
+            ("j773gap", True, "26.6.2", True),
+            ("j715ap", True, "26.5.1", False),
+            ("j713ap", True, "26.4", False),
+        ):
+            with self.subTest(device=device, expert=expert, version=version):
+                obj = self.installer(device, version)
+                state = obj.sysinfo
+                state.show = Mock()
+                state.boot_mode = "macOS"
+                state.login_user = "fixture"
+                obj.input = Mock()
+                obj.yesno = Mock(return_value=expert)
+                obj.main_loop = Mock(return_value=False)
+                with patch.object(main.system, "SystemInfo", return_value=state), \
+                     patch.dict(main.os.environ, {"EXPERT": "1" if expert else ""}), \
+                     contextlib.redirect_stdout(io.StringIO()):
+                    if succeeds:
+                        obj.main()
+                        obj.main_loop.assert_called_once()
+                    else:
+                        with self.assertRaises(SystemExit):
+                            obj.main()
+                        obj.main_loop.assert_not_called()
+
+    def test_air_restore_path_and_unknown_layout(self):
+        obj = StubInstaller.__new__(StubInstaller)
+        obj.bootcaches = {"bless2": {"Version": 1, "BootObjects": {}}}
+        obj.install_version = "26.5.1"
+        self.assertEqual(obj.restore_bundle_path(), "restore")
+        obj.install_version = "26.5.2"
+        with self.assertRaises(ValueError):
+            obj.restore_bundle_path()
+
+    def test_fwextract_cli_accepts_air_profile(self):
+        with patch("sys.argv", ["gravity-fwextract", "source", "dest", "--machine", "j713"]), \
+             patch.object(update, "update_firmware") as rebuild:
+            update.main()
+        rebuild.assert_called_once_with(Path("source"), Path("dest"), machine="j713", open_firmware=None)
+
+    def installer(self, device="j713ap", version="26.5.1"):
+        obj = main.InstallerMain.__new__(main.InstallerMain)
+        obj.sysinfo = SimpleNamespace(sys_firmware="mBoot-18000.120.36",
+            macos_ver=version, sfr_full_ver="25.6.80.0.0,0", chip_id=0x8132,
+            device_class=device)
+        obj.device = main.DEVICES.get(device, main.Device("26.5.1", False))
+        obj.expert = True
+        obj.choice = lambda prompt, options, default=None: default
+        return obj
+
+    def choose(self, device="j713ap", version="26.5.1", supported=None):
+        with contextlib.redirect_stdout(io.StringIO()):
+            return self.installer(device, version).choose_ipsw(supported)
+
+    def test_air_selects_qualified_2651(self):
+        self.assertIn("j713ap", main.DEVICES)
+        self.assertTrue(main.DEVICES["j713ap"].expert_only)
+        choice = self.choose()
+        self.assertEqual(choice.version, "26.5.1")
+        self.assertEqual(choice.devices, ["j713ap"])
+        self.assertEqual(choice.url, "https://updates.cdn-apple.com/2026SpringFCS/fullrestores/122-88870/E47EBB85-45F2-4E3C-B9E7-6FF7868C2FBA/UniversalMac_26.5.1_25F80_Restore.ipsw")
+
+    def test_mini_retains_2662_minimum(self):
+        self.assertEqual(main.CHIP_MIN_VER[0x8132], "26.6.2")
+        self.assertEqual(main.DEVICES["j773gap"].min_ver, "26.6.2")
+        self.assertEqual(self.choose("j773gap", "26.6.2").version, "26.6.2")
+        with self.assertRaises(SystemExit):
+            self.choose("j773gap", "26.6.2", ["26.5.1"])
+
+    def test_air_rejects_unqualified_firmware_and_old_host(self):
+        for supported in (["26.6.2"], []):
+            with self.subTest(supported=supported), self.assertRaises(SystemExit):
+                self.choose(supported=supported)
+        with self.assertRaises(SystemExit):
+            self.choose(version="26.5")
+
+    def test_host_version_does_not_select_boot_firmware(self):
+        for host in ("26.5.1", "26.5.2", "26.6.2"):
+            with self.subTest(host=host):
+                self.assertEqual(self.choose(version=host).version, "26.5.1")
+
+    def test_air_enforces_recovery_minimum_and_expert_selection(self):
+        for expert, sfr in ((False, "25.6.80.0.0,0"), (True, "25.6.79.0.0,0")):
+            obj = self.installer()
+            obj.expert = expert
+            obj.sysinfo.sfr_full_ver = sfr
+            with contextlib.redirect_stdout(io.StringIO()), self.assertRaises(SystemExit):
+                obj.choose_ipsw()
+
+    def test_other_m4_models_are_not_enabled(self):
+        for name in ("j715ap", "j614ap", "j616ap"):
+            self.assertNotIn(name, main.DEVICES)
+
+    def test_recovery_uses_exact_qualified_hashes(self):
+        profile = recovery.QUALIFIED_IMAGES[("26.5.1", "022-21678-093.dmg.aea")]
+        self.assertEqual(profile["encrypted_sha256"], "12919ca28b831ec9ff71291ac857a51cef54263f4846180c7b7311a58c51d13e")
+        self.assertEqual(profile["decoded_sha256"], "c7e05c0261a687b256c9ee58341346fbb995dfd04f03affd874524e6bc2e615d")
+
+    def test_radio_selection_ignores_other_boards_and_steppings(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            for dest, name in WIFI.items():
+                for stepping in ("C0", "C2"):
+                    path = root / "wifi" / ("C-4388__s-" + stepping) / name
+                    path.parent.mkdir(parents=True, exist_ok=True)
+                    payload = f"fixture ={stepping}/{name}\n" if name.endswith(".txt") else f"{stepping}/{name}"
+                    path.write_bytes(payload.encode())
+            bt = root / "bt"
+            bt.mkdir()
+            for dest, name in BT.items():
+                (bt / name).write_bytes(dest.encode())
+                (bt / name.replace("Garden", "Sakhalin")).write_bytes(b"wrong board")
+            wifi = dict(WiFiFWCollection(str(root / "wifi"), machine="j713").files())
+            bluetooth = dict(BluetoothFWCollection(str(bt), machine="j713").files())
+            self.assertEqual(set(wifi), set(WIFI))
+            self.assertEqual(set(bluetooth), set(BT))
+            for name, firmware in wifi.items():
+                source = WIFI[name]
+                expected = f"fixture=C2/{source}\n" if name.endswith(".txt") else f"C2/{source}"
+                self.assertEqual(firmware.data, expected.encode())
+            for name, firmware in bluetooth.items():
+                self.assertEqual(firmware.data, name.encode())
+            for source in WIFI.values():
+                path = root / "wifi/C-4388__s-C2" / source
+                data = path.read_bytes()
+                path.unlink()
+                with self.subTest(missing=source), self.assertRaises(FileNotFoundError):
+                    list(WiFiFWCollection(str(root / "wifi"), machine="j713").files())
+                path.write_bytes(data)
+            for source in BT.values():
+                path = bt / source
+                data = path.read_bytes()
+                path.unlink()
+                with self.subTest(missing=source), self.assertRaises(FileNotFoundError):
+                    list(BluetoothFWCollection(str(bt), machine="j713").files())
+                path.write_bytes(data)
+
+    def test_air_has_no_unqualified_bundled_open_firmware(self):
+        self.assertEqual(list(OpenFirmwareCollection(machine="j713").files()), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
