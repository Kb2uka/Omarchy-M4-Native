@@ -0,0 +1,116 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+"""Qualify J713 recovery and radio packaging on scratch storage only."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import plistlib
+import subprocess
+from types import SimpleNamespace
+import zipfile
+import zlib
+
+from gravity_firmware.bluetooth import BluetoothFWCollection
+from gravity_firmware.core import FWPackage
+from gravity_firmware.wifi import WiFiFWCollection
+from recovery import mounted_recovery
+from stub import StubInstaller
+from test_m4_firmware import read_newc
+from urlcache import URLCache
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+class CachedRecoveryPackage:
+    def __init__(self, archive, encrypted):
+        self.archive = archive
+        self.encrypted = encrypted
+        member = archive.getinfo("022-21678-093.dmg.aea")
+        size, crc = 0, 0
+        with encrypted.open("rb") as source:
+            while data := source.read(1024 * 1024):
+                size += len(data)
+                crc = zlib.crc32(data, crc)
+        require(size == member.file_size and crc == member.CRC,
+                "The cached recovery does not match the IPSW member")
+
+    def open(self, name):
+        if name == "022-21678-093.dmg.aea":
+            return self.encrypted.open("rb")
+        return self.archive.open(name)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("ipsw_url")
+    parser.add_argument("encrypted", type=Path)
+    parser.add_argument("known_radio", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=False)
+    before = plistlib.loads(subprocess.check_output(["diskutil", "list", "-plist", "disk0"]))
+    installer = StubInstaller(SimpleNamespace(board_id=0x2C, chip_id=0x8132,
+        device_class="j713ap"), None, None)
+    installer.install_version = "26.5.1"
+    cache = URLCache(args.ipsw_url)
+    try:
+        with zipfile.ZipFile(cache) as archive:
+            installer.pkg = CachedRecoveryPackage(archive, args.encrypted)
+            # Uses real IPSW metadata, hash validation, native aea/hdiutil, and
+            # the same collector entry points used before partition creation.
+            installer.preflight_recovery()
+            require(installer.identity["Info"]["BuildNumber"] == "25F80", "Unexpected build")
+            machine = installer.identity["Info"]["DeviceClass"].removesuffix("ap")
+            require(machine == "j713", "Unexpected device")
+            (args.output / "bootcaches.plist").write_bytes(plistlib.dumps(installer.bootcaches))
+            report = {"version": "26.5.1", "build": "25F80", "device": "j713ap"}
+            report["restore_bundle"] = installer.restore_bundle_path()
+            require(report["restore_bundle"] == "restore", "Unexpected restore directory")
+            with mounted_recovery(installer.recovery_image.path) as mount:
+                wifi = dict(WiFiFWCollection(installer.recovery_wifi_source(mount), machine=machine).files())
+                bluetooth = dict(BluetoothFWCollection(str(mount / "usr/share/firmware/bluetooth"), machine=machine).files())
+                files = wifi | bluetooth
+                known = json.loads(args.known_radio.read_text())
+                require({Path(name).name for name in files} == set(known), "Unexpected radio inventory")
+                report["radio"] = {}
+                for name, firmware in files.items():
+                    expected = known[Path(name).name]
+                    digest = hashlib.sha256(firmware.data).hexdigest()
+                    require(digest == expected["sha256"], f"Incorrect hash: {name}")
+                    require(len(firmware.data) == expected["size"], f"Incorrect size: {name}")
+                    report["radio"][name] = digest
+                output = args.output / "firmware"
+                output.mkdir()
+                with FWPackage(output) as package:
+                    package.add_files(sorted(files.items()))
+                cpio = read_newc(output / "firmware.cpio")
+                require(set(cpio) == {"vendorfw/" + name for name in files} | {"vendorfw/.vendorfw.manifest"},
+                        "Unexpected CPIO inventory")
+                extracted = args.output / "extracted"
+                extracted.mkdir()
+                subprocess.run(["/usr/bin/tar", "-xf", str(output / "firmware.cpio"),
+                                "-C", str(extracted)], check=True)
+                for name, firmware in files.items():
+                    require((extracted / "vendorfw" / name).read_bytes() == firmware.data,
+                            f"Incorrect extracted file: {name}")
+                amkor = extracted / "vendorfw/brcm/brcmbt4388c2-apple,garden-a.ptb"
+                usi = extracted / "vendorfw/brcm/brcmbt4388c2-apple,garden-u.ptb"
+                require(amkor.stat().st_ino == usi.stat().st_ino, "Shared PTB hard link missing")
+                report["cpio_sha256"] = hashlib.sha256((output / "firmware.cpio").read_bytes()).hexdigest()
+            after = plistlib.loads(subprocess.check_output(["diskutil", "list", "-plist", "disk0"]))
+            require(before == after, "Host physical disk layout changed")
+            report["disk0_unchanged"] = True
+            (args.output / "report.json").write_text(json.dumps(report, indent=2) + "\n")
+            print(json.dumps(report, indent=2))
+    finally:
+        if installer.recovery_image is not None:
+            installer.recovery_image.close()
+        cache.close_connection()
+
+
+if __name__ == "__main__":
+    main()
