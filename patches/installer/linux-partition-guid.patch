@@ -46,3 +50,60 @@ class PartitionSelectionTests(unittest.TestCase):
                 with self.assertRaisesRegex(Exception, 'Could not uniquely identify'):
                     disk.addPartition('disk0s4', '%Linux%', '%noformat%', 1073741824)
                 disk.get_partition_info.assert_not_called()
+
+    def test_linux_guid_forms_match_diskutil_content(self):
+        guid = '0fc63daf-8483-4772-8e79-3d69d8477de4'
+        for requested, actual in [(guid, 'Linux Filesystem'),
+                                  (guid.upper(), 'Linux Filesystem'),
+                                  ('Linux', guid), (guid, guid.upper())]:
+            with self.subTest(requested=requested, actual=actual):
+                wanted = partition('disk0s8', actual, 'new-root')
+                disk = self.setup_disk([partition('disk0s6', 'Apple_Boot', 'helper'), wanted])
+                self.assertIs(disk.addPartition('disk0s4', '%' + requested + '%',
+                                               '%noformat%', 1073741824), wanted)
+
+    def test_identified_root_template_through_real_partition_method(self):
+        fixture = Path(__file__).with_name('fixtures') / 'j713-ssd-20261009.json'
+        template = json.loads(fixture.read_text())['os_list'][0]
+        stub = partition('disk0s5', 'Apple_APFS', 'existing-stub')
+        efi = Partition('disk0s4', stub.offset + stub.size, 524288000,
+                        False, 'EFI', 'new-efi')
+        root = Partition('disk0s8', efi.offset + efi.size, 381225533440,
+                         False, 'Linux Filesystem', 'new-root')
+        helper = Partition('disk0s6', root.offset + root.size, 134217728,
+                           False, 'Apple_Boot', 'new-helper')
+        free = Partition(helper.name, helper.offset + helper.size, 32 << 20, True, None)
+        # get_partitions names free extents after the preceding partition.
+        before_efi = Partition(stub.name, efi.offset,
+                               efi.size + root.size + helper.size + free.size, True, None)
+        after_efi = Partition(efi.name, root.offset,
+                              root.size + helper.size + free.size, True, None)
+        disk = DiskUtil()
+        disk.disk_parts = {}
+        disk.get_partitions = Mock(side_effect=[[stub, before_efi], [stub, efi, after_efi],
+                                                [stub, efi, after_efi],
+                                                [stub, efi, root, helper, free]])
+        disk.action = Mock()
+        disk.get_list = Mock()
+        disk.get_partition_info = Mock(side_effect=lambda name, **kwargs:
+                                       {efi.name: efi, root.name: root}[name])
+        installer = OSInstaller(disk, {}, template)
+        with patch('osinstall.subprocess.run'):
+            installer.partition_disk(stub.name, 381749821440)
+        self.assertEqual(installer.part_info, [efi, root])
+        self.assertIs(installer.efi_part, efi)
+        self.assertEqual(disk.action.call_count, 2)
+        self.assertEqual(disk.action.call_args.args[2], '%0fc63daf-8483-4772-8e79-3d69d8477de4%')
+
+    def test_guid_request_rejects_missing_existing_ambiguous_and_wrong_types(self):
+        for added in [[], [partition('disk0s8', 'Linux Filesystem', 'existing-linux')],
+                      [partition('disk0s8', 'Linux Filesystem', 'one'),
+                       partition('disk0s9', 'Linux Filesystem', 'two')],
+                      [partition('disk0s8', 'Apple_Boot', 'new')],
+                      [partition('disk0s8', '0657FD6D-A4AB-43C4-84E5-0933C84B4F4F', 'new')]]:
+            with self.subTest(added=added):
+                disk = self.setup_disk(added)
+                with self.assertRaisesRegex(Exception, 'Could not uniquely identify'):
+                    disk.addPartition('disk0s4', '%0fc63daf-8483-4772-8e79-3d69d8477de4%',
+                                      '%noformat%', 1073741824)
+                disk.get_partition_info.assert_not_called()
