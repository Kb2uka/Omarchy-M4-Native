+				};
+			};
 		};
 
 		dwc3_1_dart_0: iommu@40af00000 {
@@ -665,6 +748,34 @@ atcphy1: phy@40b000000 {
 			#phy-cells = <1>;
 			#reset-cells = <0>;
 
