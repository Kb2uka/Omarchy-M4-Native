+
+		atcphy0_xbar: mux@40304c000 {
+			compatible = "apple,t8132-display-crossbar",
+			             "apple,t8112-display-crossbar";
+			reg = <0x4 0x0304c000 0x0 0x4000>;
+			#mux-control-cells = <1>;
 			power-domains = <&ps_atc0_usb>;
 		};
 
@@ -623,6 +685,9 @@ dwc3_1: usb@40a280000 {
 			reg-names = "dwc3-core", "dwc3-apple";
 			interrupt-parent = <&aic>;
 			interrupts = <AIC_IRQ 1341 IRQ_TYPE_LEVEL_HIGH>;
+			dr_mode = "otg";
+			usb-role-switch;
+			role-switch-default-mode = "host";
 			iommus = <&dwc3_1_dart_0 0>,
 			         <&dwc3_1_dart_1 1>;
 			power-domains = <&ps_atc1_usb>;
@@ -630,6 +695,24 @@ dwc3_1: usb@40a280000 {
 			phys = <&atcphy1 PHY_TYPE_USB2>, <&atcphy1 PHY_TYPE_USB3>;
 			phy-names = "usb2-phy", "usb3-phy";
 			status = "disabled";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
