+					dwc3_0_ss: endpoint {
+						remote-endpoint = <&atcphy0_usb3>;
+					};
+				};
+			};
 		};
 
 		dwc3_0_dart_0: iommu@402f00000 {
@@ -613,6 +647,34 @@ atcphy0: phy@403000000 {
 			#phy-cells = <1>;
 			#reset-cells = <0>;
 
+			orientation-switch;
+			mode-switch;
+			power-domains = <&ps_atc0_usb>;
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
